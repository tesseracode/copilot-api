+export function pricingNameToModelId(displayName: string): string {
+  const withoutFootnotes = displayName.replaceAll(/\[\^[^\]]*\]/g, "")
+  return withoutFootnotes.trim().toLowerCase().replaceAll(/\s+/g, "-")
