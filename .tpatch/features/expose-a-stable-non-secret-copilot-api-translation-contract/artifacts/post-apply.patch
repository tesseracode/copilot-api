+
+  it("trims surrounding whitespace", () => {
+    expect(sanitizeRevision("  abc1234  ")).toBe("abc1234")
+  })
+
+  it.each([
+    "a".repeat(65),
+    "has space",
+    "semi;colon",
+    "new\nline",
+    "/etc/passwd",
