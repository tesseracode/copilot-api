index 0000000..2df308b
--- /dev/null
+++ b/src/lib/responses-stream-wrapper.ts
@@ -0,0 +1,78 @@
+import { STREAM_TRANSPORT_ERROR } from "./streaming"
+
+const encoder = new TextEncoder()
+
+function isAbort(error: unknown, signal?: AbortSignal): boolean {
+  return (
+    signal?.aborted === true
+    || (error instanceof Error && error.name === "AbortError")
+  )
+}
+
+function containsTerminalError(text: string): boolean {
+  return (
+    text.includes("event: error")
+    || text.includes('"type":"error"')
+    || text.includes('"type":"response.failed"')
+  )
+}
+
+export function wrapResponsesStream(
+  body: ReadableStream<Uint8Array>,
+  signal?: AbortSignal,
+): ReadableStream<Uint8Array> {
+  const reader = body.getReader()
+  const decoder = new TextDecoder()
+  let inspectionBuffer = ""
+  let terminalErrorSeen = false
+  let abortListener: (() => void) | undefined
+
+  function cleanup(): void {
+    if (abortListener) signal?.removeEventListener("abort", abortListener)
+  }
+
+  return new ReadableStream<Uint8Array>({
+    start() {
+      abortListener = () => void reader.cancel(signal?.reason)
+      signal?.addEventListener("abort", abortListener, { once: true })
+    },
+    async pull(controller) {
+      try {
+        const result = await reader.read()
+        if (result.done) {
+          cleanup()
+          controller.close()
+          return
+        }
+        inspectionBuffer = `${inspectionBuffer}${decoder.decode(result.value, {
+          stream: true,
+        })}`.slice(-1024)
+        terminalErrorSeen ||= containsTerminalError(inspectionBuffer)
+        controller.enqueue(result.value)
+      } catch (error) {
+        cleanup()
+        if (isAbort(error, signal)) {
+          controller.close()
+          return
+        }
+        if (!terminalErrorSeen) {
+          controller.enqueue(
+            encoder.encode(
+              `event: error\ndata: ${JSON.stringify({
+                type: "error",
+                code: STREAM_TRANSPORT_ERROR.code,
+                message: STREAM_TRANSPORT_ERROR.message,
+                param: null,
+              })}\n\n`,
+            ),
+          )
+        }
+        controller.close()
+      }
+    },
+    async cancel(reason) {
+      cleanup()
+      await reader.cancel(reason)
+    },
+  })
+}
